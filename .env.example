# Google Analytics - ID de medición (formato G-XXXXXXXXXX)
NEXT_PUBLIC_GA_ID=

# Google Search Console - código de verificación (solo el valor, sin "google-site-verification=")
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# URL del sitio (para sitemap y canonical)
# El dominio CANÓNICO que queremos que Google indexe.
# Cuando actives el .com cámbialo aquí.
CANONICAL_URL=https://www.visita-papa-2026.es
SITE_URL=https://www.visita-papa-2026.es

# === Formulario de contacto ===
# Resend (https://resend.com) — free tier 3.000 emails/mes. Crear cuenta,
# verificar el dominio (o usar from@resend.dev en pruebas), y generar API key.
RESEND_API_KEY=

# Email destino del formulario (buzón del responsable)
CONTACT_TO_EMAIL=daniel.mirond@gmail.com

# Email "From" (debe estar verificado en Resend; ideal: contacto@visita-papa-2026.com)
CONTACT_FROM_EMAIL=contacto@visita-papa-2026.com

# ============================================================
# === SISTEMA DE AFILIACIÓN MEJORADO ===
# ============================================================
# Todos los IDs de afiliación se configuran aquí.
# Si no están definidos, el sistema usa valores por defecto (DEV_AID)
# y no generará comisiones reales en producción.
#
# IMPORTANTE: Estos valores se usan directamente en URLs sin validación extra.
# Asegúrate de que están CORRECTOS antes de desplegar a producción.

# Booking.com - Affiliate ID (obtener en: https://affiliate.booking.com)
# Comisión típica: 3% por reserva
NEXT_PUBLIC_BOOKING_AID=

# Trainline - Affiliate ID (obtener en: https://affiliate.thetrainline.com)
# O usar AWIN si está integrado. Comisión típica: 4-6%
NEXT_PUBLIC_TRAINLINE_AID=

# Renfe - NO tiene programa público de afiliados (usar Trainline como fallback)
NEXT_PUBLIC_RENFE_AID=

# Skyscanner - Affiliate ID (obtener en: https://www.skyscanner.es/partnerships/)
# Comisión típica: 2%
NEXT_PUBLIC_SKYSCANNER_AID=

# Amazon.es - Tag de afiliado (formato: xxxx-21)
# Obtener en: https://afiliados.amazon.es
# Default: nuus-21 (nuestro tag)
NEXT_PUBLIC_AMAZON_TAG=nuus-21

# Intermundial - Affiliate ID (obtener en: https://www.intermundial.es/profesionales)
# Seguros de viaje. Comisión típica: 8%
NEXT_PUBLIC_INTERMUNDIAL_AID=

# Civitatis - Affiliate ID (obtener en: https://partner.civitatis.com)
# Tours y actividades. Comisión típica: 10%
NEXT_PUBLIC_CIVITATIS_AID=

# GetYourGuide - Partner ID (obtener en: https://partners.getyourguide.com)
# Tours y atracciones. Comisión típica: 5%
NEXT_PUBLIC_GETYOURGUIDE_AID=

# Holafly - Affiliate ID (obtener en: https://affiliate.holafly.com)
# eSIM para viajeros. Comisión típica: 3%
NEXT_PUBLIC_HOLAFLY_AID=

# Airalo - Affiliate ID (obtener en: https://www.airalo.com/affiliates)
# eSIM global. Comisión típica: 5%
NEXT_PUBLIC_AIRALO_AID=

# Hertz - Partner/Affiliate ID (obtener en: https://www.hertzaffiliates.com)
# Alquiler de coches. Comisión típica: 5%
NEXT_PUBLIC_HERTZ_AID=

# Sixt - Affiliate ID (obtener en: https://www.sixt.es/partners)
# Alquiler de coches premium. Comisión típica: 5%
NEXT_PUBLIC_SIXT_AID=

# AWIN - Publisher ID (obtener en: https://ui.awin.com)
# Red de afiliación que integra multiples proveedores
# Solo usar si está integrado como fallback
NEXT_PUBLIC_AWIN_PID=

# Feature flag de la tienda de merchandising.
# - 'true' → la tienda es visible (nav + ruta /tienda accesible)
# - No definido o cualquier otra cosa → la tienda está oculta (404 + sin nav)
# En producción dejar SIN DEFINIR hasta que queramos lanzar la tienda.
NEXT_PUBLIC_SHOP_ENABLED=false
